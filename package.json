{
  "name": "agripinaa",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @agripinaa/web dev",
    "build": "pnpm --filter @agripinaa/web build",
    "typecheck": "pnpm -r --if-present typecheck",
    "typecheck:ci": "pnpm --filter @agripinaa/web typegen && pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "seed:agents": "pnpm --filter @agripinaa/agent-index seed"
  },
  "pnpm": {
    "overrides": {
      "@cowprotocol/app-data": "npm:@cowprotocol/sdk-app-data@5.3.3",
      "@cowprotocol/cow-sdk": "9.2.6",
      "@ophis/sdk": "0.3.0",
      "uuid": "11.1.1"
    },
    "patchedDependencies": {
      "@altananetwork/x402-server@0.2.0": "patches/@altananetwork__x402-server@0.2.0.patch",
      "@ophis/agent-swap@0.3.1": "patches/@ophis__agent-swap@0.3.1.patch"
    }
  }
}
